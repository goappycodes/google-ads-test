# Copy to .env.local and adjust. Both values are optional and are baked into
# the client bundle at build time (NEXT_PUBLIC_*), so never put secrets here.

# Address students are told to email their HTML report to (used in the exam
# guide, Review screen, report footer and the "Email submission" mailto link).
NEXT_PUBLIC_SUBMISSION_EMAIL=madhu@nexisschool.com

# Name used in the greeting of the pre-filled submission email ("Dear ...").
NEXT_PUBLIC_SUBMISSION_NAME=Madhu
